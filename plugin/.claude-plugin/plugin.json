{
  "name": "grokpair",
  "version": "2.3.2",
  "description": "Delegate research, reviews, code, documents or media to a detached Grok Build collaborator while your agent keeps working. Requires your own Grok Build installation and authentication.",
  "author": {
    "name": "Tiziano AI",
    "url": "https://github.com/Tiziano-AI"
  },
  "homepage": "https://github.com/Tiziano-AI/grokpair",
  "repository": "https://github.com/Tiziano-AI/grokpair",
  "license": "MIT",
  "keywords": [
    "grok",
    "xai",
    "grok-build",
    "acp",
    "mcp",
    "codex-plugin",
    "claude-code-plugin",
    "delegation",
    "subagent"
  ],
  "icon": "./skills/grokpair/assets/grokpair.png",
  "mcpServers": {
    "grokpair": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/grokpair",
      "args": [
        "mcp"
      ],
      "timeout": 660000
    }
  }
}
