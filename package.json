{
  "name": "grokpair",
  "version": "2.3.2",
  "private": true,
  "type": "module",
  "description": "Delegate research, reviews, code, documents or media to a detached Grok Build collaborator while your agent keeps working. Requires your own Grok Build installation and authentication.",
  "license": "MIT",
  "author": "Tiziano AI",
  "homepage": "https://github.com/Tiziano-AI/grokpair#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiziano-AI/grokpair.git"
  },
  "bugs": {
    "url": "https://github.com/Tiziano-AI/grokpair/issues"
  },
  "keywords": [
    "grok",
    "xai",
    "grok-build",
    "acp",
    "mcp",
    "codex-plugin",
    "claude-code-plugin",
    "delegation",
    "subagent"
  ],
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "bin": {
    "grokpair": "plugin/bin/grokpair"
  },
  "files": [
    "plugin/",
    "docs/",
    "README.md",
    "ARCH.md",
    "LICENSE",
    "TERMS.md",
    "PRIVACY.md",
    "SECURITY.md",
    "RELEASE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "pnpm build && node scripts/test.mjs",
    "validate": "pnpm build && node scripts/validate.mjs",
    "mcp:check": "pnpm build && node scripts/check-mcp.mjs",
    "skill:validate": "node scripts/check-skill.mjs",
    "native:check": "node scripts/check-no-native.mjs"
  },
  "engines": {
    "node": ">=24.21"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
