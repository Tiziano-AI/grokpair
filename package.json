{
  "name": "grokpair",
  "version": "2.3.3",
  "private": true,
  "type": "module",
  "description": "Delegate research, reviews, code, documents or media to a detached Grok Build collaborator while your agent keeps working. Requires your own Grok Build installation and authentication.",
  "license": "MIT",
  "author": "Tiziano AI",
  "homepage": "https://github.com/Tiziano-AI/grokpair#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiziano-AI/grokpair.git"
  },
  "bugs": {
    "url": "https://github.com/Tiziano-AI/grokpair/issues"
  },
  "keywords": [
    "grok",
    "xai",
    "grok-build",
    "acp",
    "mcp",
    "codex-plugin",
    "claude-code-plugin",
    "delegation",
    "subagent"
  ],
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "bin": {
    "grokpair": "plugin/bin/grokpair"
  },
  "files": [
    "plugin/",
    "docs/",
    "README.md",
    "ARCH.md",
    "LICENSE",
    "TERMS.md",
    "PRIVACY.md",
    "SECURITY.md",
    "RELEASE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "pnpm build && node scripts/test.mjs",
    "validate": "pnpm build && node scripts/validate.mjs",
    "mcp:check": "pnpm build && node scripts/check-mcp.mjs",
    "skill:validate": "node scripts/check-skill.mjs",
    "native:check": "node scripts/check-no-native.mjs"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
